<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CrushKit.Brutal.Input" Version="$(CrushKitVersion)" Condition="'$(UseCrushKitProjects)' != 'true'" />
    <ProjectReference Include="$(CrushKitRoot)/src/CrushKit.Brutal.Input/CrushKit.Brutal.Input.csproj" Condition="'$(UseCrushKitProjects)' == 'true'" />
  </ItemGroup>
</Project>
