<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BrutalBreakout</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Update="overlay.json;Assets/Fonts/**/*;Assets/Images/**/*;window.json;physics.json;gameplay.json;input.json;colors.json;style.json;color-schemes/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Audio/**/*.cs;Rendering/Shapes/**/*.cs;Simulation/**/*.cs;Platform/**/*.cs;tests/**/*.cs" />
    <PackageReference Include="CrushKit.Brutal.Draw2D" Version="$(CrushKitVersion)" Condition="'$(UseCrushKitProjects)' != 'true'" />
    <PackageReference Include="CrushKit.Brutal.Vulkan" Version="$(CrushKitVersion)" Condition="'$(UseCrushKitProjects)' != 'true'" />
    <PackageReference Include="CrushKit.Brutal.ImGui" Version="$(CrushKitVersion)" Condition="'$(UseCrushKitProjects)' != 'true'" />
    <ProjectReference Include="$(CrushKitRoot)/src/CrushKit.Brutal.ImGui/CrushKit.Brutal.ImGui.csproj" Condition="'$(UseCrushKitProjects)' == 'true'" />
    <ProjectReference Include="Simulation/BrutalBreakout.Simulation.csproj" />
    <ProjectReference Include="Audio/BrutalBreakout.Audio.csproj" />
    <ProjectReference Include="Platform/Input/BrutalBreakout.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
