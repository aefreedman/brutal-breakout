<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BrutalBreakout</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rendering/Shaders/shapes.vert;Rendering/Shaders/shapes.frag" />
    <None Update="overlay.json;Assets/Fonts/**/*;Assets/Images/**/*;window.json;physics.json;gameplay.json;input.json;colors.json;style.json;color-schemes/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Audio/**/*.cs;Rendering/Shapes/**/*.cs;Simulation/**/*.cs;Platform/**/*.cs;tests/**/*.cs" />
    <ProjectReference Include="Rendering/Shapes/BrutalBreakout.Shapes.csproj" />
    <ProjectReference Include="Simulation/BrutalBreakout.Simulation.csproj" />
    <ProjectReference Include="Platform/Input/BrutalBreakout.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Ttf" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Stb" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5" />
    <PackageReference Include="Ahwoo.BRUTAL.ShaderC" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Vma" Version="2026.10.3" />
  </ItemGroup>

  <!-- Notices for the newly introduced graphics dependency closure, including native third-party notices. -->
