<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CrushKit.Brutal.Ecs" Version="$(CrushKitVersion)" Condition="'$(UseCrushKitProjects)' != 'true'" />
    <PackageReference Include="CrushKit.Brutal.Physics" Version="$(CrushKitVersion)" Condition="'$(UseCrushKitProjects)' != 'true'" />
    <ProjectReference Include="$(CrushKitRoot)/src/CrushKit.Brutal.Ecs/CrushKit.Brutal.Ecs.csproj" Condition="'$(UseCrushKitProjects)' == 'true'" />
    <ProjectReference Include="$(CrushKitRoot)/src/CrushKit.Brutal.Physics/CrushKit.Brutal.Physics.csproj" Condition="'$(UseCrushKitProjects)' == 'true'" />
    <InternalsVisibleTo Include="Simulation.Tests" />
  </ItemGroup>
</Project>
