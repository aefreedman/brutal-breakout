<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Simulation/BrutalBreakout.Simulation.csproj" />
    <PackageReference Include="CrushKit.Brutal.Draw2D" Version="$(CrushKitVersion)" Condition="'$(UseCrushKitProjects)' != 'true'" />
    <ProjectReference Include="$(CrushKitRoot)/src/CrushKit.Brutal.Draw2D/CrushKit.Brutal.Draw2D.csproj" Condition="'$(UseCrushKitProjects)' == 'true'" />
    <ProjectReference Include="../../Platform/Input/BrutalBreakout.Input.csproj" />
    <!-- Compile the actual CPU consumer without restoring/building the app or changing its lock. -->
    <Compile Include="../../Presentation/PresentationStyle.cs" Link="Consumer/PresentationStyle.cs" />
    <Compile Include="../../Presentation/ColorScheme.cs" Link="Consumer/ColorScheme.cs" />
    <Compile Include="../../Presentation/BallSandbox.cs" Link="Consumer/BallSandbox.cs" />
    <Compile Include="../../Presentation/BallSandboxSession.cs" Link="Consumer/BallSandboxSession.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
